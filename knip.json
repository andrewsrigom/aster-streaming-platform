{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": [
    "apps/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
    "packages/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
    "services/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
    "tools/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
    "workers/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}"
  ],
  "workspaces": {
    "workers/media": {
      "entry": ["src/main.ts", "test/integration/encode.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    ".": { "entry": ["tools/media/generate-hls.mjs", "infra/router/init-trust.mjs"] },
    "apps/router": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "services/catalog": {
      "entry": [
        "test/router-cancellation-probe.mjs",
        "src/index.ts",
        "src/main.ts",
        "src/operate-local.ts",
        "src/acquire-local.ts",
        "src/prepare-publication-local.ts",
        "test/integration/media-origin.ts",
        "src/seed-local.ts",
        "src/initialize-web-demo.ts",
        "src/migrate-local.ts",
        "src/print-schema.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "services/identity": {
      "entry": [
        "src/index.ts",
        "src/main.ts",
        "src/migrate-local.ts",
        "src/check-identity.ts",
        "src/print-schema.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/http-express": {
      "entry": ["src/index.ts", "src/check-http-express.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/postgres": {
      "entry": ["src/index.ts", "src/check-postgres.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/redis": {
      "entry": ["src/index.ts", "src/check-redis.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/object-storage-s3": {
      "entry": ["src/index.ts", "src/check-object-storage.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/broker-kafka": {
      "entry": ["src/index.ts", "src/check-broker.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/config": {
      "entry": ["src/index.ts", "src/check-runtime-config.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/runtime": {
      "entry": ["src/index.ts", "src/check-runtime-logging.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/telemetry": {
      "entry": ["src/index.ts", "src/check-telemetry.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
