{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": [
    "apps/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
    "packages/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
    "services/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
    "tools/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
    "workers/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}"
  ],
  "workspaces": {
    "packages/http-express": {
      "entry": ["src/index.ts", "src/check-http-express.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/postgres": {
      "entry": ["src/index.ts", "src/check-postgres.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/redis": {
      "entry": ["src/index.ts", "src/check-redis.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/object-storage-s3": {
      "entry": ["src/index.ts", "src/check-object-storage.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/config": {
      "entry": ["src/index.ts", "src/check-runtime-config.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/runtime": {
      "entry": ["src/index.ts", "src/check-runtime-logging.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/telemetry": {
      "entry": ["src/index.ts", "src/check-telemetry.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
