{
  "name": "aster-streaming-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Production-oriented video-on-demand engineering system.",
  "license": "MIT",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.24.0"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "scripts": {
    "ai:check": "node ./tools/verify-ai-state.ts",
    "ai:test": "node --test ./tools/verify-ai-state.test.ts",
    "architecture:check": "node ./tools/verify-architecture.ts",
    "architecture:test": "node --test ./tools/verify-architecture.test.ts",
    "check": "node ./tools/run-quality-gate.ts",
    "check:changed": "node ./tools/run-quality-gate.ts --changed",
    "check:source": "turbo run build test toolchain:check toolchain:test typecheck lint:workspace format:check unused:check architecture:check architecture:test platform:check platform:test staged:test commit:test",
    "clean:foundation": "node ./tools/clean-foundation.mjs",
    "ci:check": "node ./tools/verify-ci-policy.ts",
    "ci:test": "node --test ./tools/classify-ci-change.test.ts ./tools/verify-ci-policy.test.ts",
    "commit:check": "node ./tools/validate-commit-message.ts",
    "commit:test": "node --test ./tools/validate-commit-message.test.ts",
    "community:check": "node ./tools/verify-community-files.ts",
    "community:test": "node --test ./tools/verify-community-files.test.ts",
    "config:check": "turbo run build --filter=@aster/config && pnpm --filter=@aster/config check",
    "config:test": "turbo run test --filter=@aster/config",
    "docs:check": "node ./tools/verify-documentation.ts",
    "docs:test": "node --test ./tools/verify-documentation.test.ts",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "http:check": "turbo run build --filter=@aster/http-express && pnpm --filter=@aster/http-express check",
    "http:test": "turbo run test --filter=@aster/http-express",
    "identity:check": "turbo run build --filter=@aster/identity && pnpm --filter=@aster/identity check",
    "identity:demo": "node ./tools/verify-local-identity.mjs",
    "identity:start": "turbo run build --filter=@aster/identity && pnpm --filter=@aster/identity start",
    "identity:test": "turbo run test --filter=@aster/identity",
    "integration": "turbo run build --filter=@aster/identity && pnpm --filter=@aster/identity integration",
    "integration:broker": "turbo run build --filter=@aster/identity && pnpm --filter=@aster/identity integration:broker",
    "integration:core": "turbo run build --filter=@aster/identity && pnpm --filter=@aster/identity integration:core",
    "integration:storage": "turbo run build --filter=@aster/identity && pnpm --filter=@aster/identity integration:storage",
    "integration:telemetry": "turbo run build --filter=@aster/identity && pnpm --filter=@aster/identity integration:telemetry",
    "lint": "turbo run build --filter=@aster/telemetry && pnpm lint:workspace",
    "lint:workspace": "eslint .",
    "logging:check": "turbo run build --filter=@aster/runtime && pnpm --filter=@aster/runtime check",
    "logging:test": "turbo run test --filter=@aster/runtime",
    "platform:check": "node ./tools/verify-local-platform.mjs",
    "platform:compose:check": "docker compose -f ./infra/compose/compose.yml config --quiet",
    "platform:test": "node --test ./tools/verify-local-platform.test.mjs ./tools/reset-local-platform.test.mjs",
    "security:check": "node ./tools/scan-secrets.ts --all",
    "security:staged": "node ./tools/scan-secrets.ts --staged",
    "security:test": "node --test ./tools/scan-secrets.test.ts",
    "staged:check": "node ./tools/check-staged-files.ts",
    "staged:test": "node --test ./tools/check-staged-files.test.ts",
    "telemetry:check": "turbo run build --filter=@aster/telemetry && pnpm --filter=@aster/telemetry check",
    "telemetry:test": "turbo run test --filter=@aster/telemetry",
    "toolchain:check": "node ./tools/verify-toolchain.mjs",
    "toolchain:test": "node --test ./tools/verify-toolchain.test.mjs ./tools/clean-foundation.test.mjs ./tools/run-quality-gate.test.ts",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "unused:check": "knip --no-config-hints"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
