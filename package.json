{
  "name": "aster-streaming-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Production-oriented video-on-demand engineering system.",
  "license": "MIT",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.24.0"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "scripts": {
    "architecture:check": "node ./tools/verify-architecture.ts",
    "architecture:test": "node --test ./tools/verify-architecture.test.ts",
    "check": "turbo run toolchain:check toolchain:test typecheck lint format:check unused:check architecture:check architecture:test docs:check docs:test security:check security:test ci:check ci:test staged:test commit:test",
    "check:source": "turbo run toolchain:check toolchain:test typecheck lint format:check unused:check architecture:check architecture:test staged:test commit:test",
    "ci:check": "node ./tools/verify-ci-policy.ts",
    "ci:test": "node --test ./tools/classify-ci-change.test.ts ./tools/verify-ci-policy.test.ts",
    "commit:check": "node ./tools/validate-commit-message.ts",
    "commit:test": "node --test ./tools/validate-commit-message.test.ts",
    "docs:check": "node ./tools/verify-documentation.ts",
    "docs:test": "node --test ./tools/verify-documentation.test.ts",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "security:check": "node ./tools/scan-secrets.ts --all",
    "security:staged": "node ./tools/scan-secrets.ts --staged",
    "security:test": "node --test ./tools/scan-secrets.test.ts",
    "staged:check": "node ./tools/check-staged-files.ts",
    "staged:test": "node --test ./tools/check-staged-files.test.ts",
    "toolchain:check": "node ./tools/verify-toolchain.mjs",
    "toolchain:test": "node --test ./tools/verify-toolchain.test.mjs",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "unused:check": "knip --no-config-hints"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
