{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "noUpdateNotifier": true,
  "cacheDir": ".turbo/cache",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "globalDependencies": [".node-version", ".nvmrc"],
  "tasks": {
    "@aster/web#build": {
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NEXT_TELEMETRY_DISABLED"]
    },
    "@aster/web#typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@aster/router#test": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["ASTER_SCHEMA_BASE"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/infra/router/**",
        "$TURBO_ROOT$/evidence/phase-02/identity-schema.graphql",
        "$TURBO_ROOT$/evidence/phase-03/catalog-schema.graphql"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    },
    "//#toolchain:check": {
      "cache": false
    },
    "//#toolchain:test": {
      "cache": false,
      "inputs": [
        "tools/clean-foundation.test.mjs",
        "tools/run-quality-gate.test.ts",
        "tools/run-quality-gate.ts",
        "tools/verify-toolchain.mjs",
        "tools/verify-toolchain.test.mjs"
      ]
    },
    "//#typecheck": {
      "inputs": ["tools/**/*.ts", "tsconfig.json", "tsconfig.base.json", "package.json"]
    },
    "//#lint:workspace": {
      "dependsOn": ["@aster/telemetry#build"],
      "inputs": [
        "apps/**",
        "eslint.config.mjs",
        "infra/router/**",
        "package.json",
        "packages/**",
        "services/**",
        "tools/**",
        "tsconfig*.json",
        "workers/**"
      ]
    },
    "//#format:check": {
      "inputs": [
        "infra/**",
        ".github/**",
        ".githooks/**",
        "**/*.md",
        "*.{js,json,jsonc,mjs,ts,yaml,yml}",
        "apps/**",
        "packages/**",
        "services/**",
        "tools/**",
        "workers/**"
      ]
    },
    "//#unused:check": {
      "inputs": [
        "infra/router/**",
        "apps/**",
        "knip.json",
        "package.json",
        "packages/**",
        "services/**",
        "tools/**",
        "tsconfig*.json",
        "workers/**"
      ]
    },
    "//#architecture:check": {
      "inputs": [
        "apps/**",
        "packages/**",
        "services/**",
        "tools/verify-architecture.ts",
        "workers/**"
      ]
    },
    "//#architecture:test": {
      "inputs": ["tools/verify-architecture.ts", "tools/verify-architecture.test.ts"]
    },
    "//#platform:check": {
      "inputs": [
        "infra/router/**",
        "patches/**",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tools/verify-router-runtime.mjs",
        ".dockerignore",
        "infra/docker/**",
        "packages/*/package.json",
        "services/identity/package.json",
        "services/catalog/package.json",
        "services/playback/package.json",
        "services/engagement/package.json",
        "services/discovery/package.json",
        "tools/verify-engagement-runtime.mjs",
        "tools/verify-playback-runtime.mjs",
        "tools/verify-catalog-runtime.mjs",
        "tools/verify-runtime-image.mjs",
        "tools/verify-optional-platform.mjs",
        "tools/verify-diagnostics-profile.mjs",
        "tools/run-diagnostic-exercises.mjs",
        "README.md",
        "docs/operations/LOCAL_DEVELOPMENT.md",
        "infra/compose/**",
        "tools/reset-local-platform.sh",
        "tools/verify-local-platform.mjs",
        "tools/verify-discovery-runtime.mjs"
      ]
    },
    "//#platform:test": {
      "inputs": [
        "infra/router/**",
        "patches/**",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tools/verify-router-runtime.mjs",
        "tools/verify-router-runtime.test.mjs",
        ".dockerignore",
        "infra/docker/**",
        "packages/*/package.json",
        "services/identity/package.json",
        "services/catalog/package.json",
        "services/playback/package.json",
        "services/engagement/package.json",
        "services/discovery/package.json",
        "tools/verify-engagement-runtime.mjs",
        "tools/verify-engagement-runtime.test.mjs",
        "tools/verify-playback-runtime.mjs",
        "tools/verify-playback-runtime.test.mjs",
        "tools/verify-catalog-runtime.mjs",
        "tools/verify-catalog-runtime.test.mjs",
        "tools/media/**",
        "tools/verify-runtime-image.mjs",
        "tools/verify-optional-platform.mjs",
        "tools/verify-diagnostics-profile.mjs",
        "tools/verify-diagnostics-profile.test.mjs",
        "tools/run-diagnostic-exercises.mjs",
        "tools/run-diagnostic-exercises.test.mjs",
        "README.md",
        "docs/operations/LOCAL_DEVELOPMENT.md",
        "infra/compose/**",
        "tools/reset-local-platform.sh",
        "tools/reset-local-platform.test.mjs",
        "tools/verify-local-platform.mjs",
        "tools/verify-local-platform.test.mjs",
        "tools/verify-discovery-runtime.mjs",
        "tools/verify-discovery-runtime.test.mjs"
      ]
    },
    "//#ai:check": {
      "inputs": [".ai/**", "tools/verify-ai-state.ts"]
    },
    "//#ai:test": {
      "inputs": [".ai/**", "tools/verify-ai-state.ts", "tools/verify-ai-state.test.ts"]
    },
    "//#docs:check": {
      "inputs": ["**/*"]
    },
    "//#docs:test": {
      "inputs": ["tools/verify-documentation.ts", "tools/verify-documentation.test.ts"]
    },
    "//#community:check": {
      "inputs": ["**/*"]
    },
    "//#community:test": {
      "inputs": [
        ".github/ISSUE_TEMPLATE/**",
        ".github/PULL_REQUEST_TEMPLATE.md",
        "CONTRIBUTING.md",
        "SECURITY.md",
        "tools/verify-community-files.ts",
        "tools/verify-community-files.test.ts"
      ]
    },
    "//#security:check": {
      "cache": false,
      "inputs": ["**/*"]
    },
    "//#security:test": {
      "inputs": ["tools/scan-secrets.ts", "tools/scan-secrets.test.ts"]
    },
    "//#ci:check": {
      "inputs": [
        ".github/**",
        "infra/compose/**",
        "tools/verify-ci-policy.ts",
        "tools/resolve-schema-baseline.ts",
        "tools/verify-local-platform.mjs",
        "tools/verify-discovery-runtime.mjs"
      ]
    },
    "//#ci:test": {
      "inputs": [
        ".github/**",
        "tools/classify-ci-change.ts",
        "tools/classify-ci-change.test.ts",
        "tools/verify-ci-policy.ts",
        "tools/verify-ci-policy.test.ts",
        "tools/resolve-schema-baseline.ts",
        "tools/resolve-schema-baseline.test.ts",
        "tools/reset-local-platform.sh",
        "tools/reset-local-platform.test.mjs",
        "tools/verify-local-platform.mjs",
        "tools/verify-local-platform.test.mjs",
        "tools/verify-discovery-runtime.mjs",
        "tools/verify-discovery-runtime.test.mjs"
      ]
    },
    "//#commit:test": {
      "inputs": ["tools/validate-commit-message.ts", "tools/validate-commit-message.test.ts"]
    },
    "//#staged:test": {
      "inputs": ["tools/check-staged-files.ts", "tools/check-staged-files.test.ts"]
    }
  }
}
