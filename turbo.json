{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "noUpdateNotifier": true,
  "cacheDir": ".turbo/cache",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "globalDependencies": [".node-version", ".nvmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "//#toolchain:check": {
      "cache": false
    },
    "//#toolchain:test": {
      "cache": false,
      "inputs": [
        "tools/clean-foundation.test.mjs",
        "tools/run-quality-gate.test.ts",
        "tools/run-quality-gate.ts",
        "tools/verify-toolchain.mjs",
        "tools/verify-toolchain.test.mjs"
      ]
    },
    "//#typecheck": {
      "inputs": ["tools/**/*.ts", "tsconfig.json", "tsconfig.base.json", "package.json"]
    },
    "//#lint:workspace": {
      "dependsOn": ["@aster/telemetry#build"],
      "inputs": [
        "apps/**",
        "eslint.config.mjs",
        "package.json",
        "packages/**",
        "services/**",
        "tools/**",
        "tsconfig*.json",
        "workers/**"
      ]
    },
    "//#format:check": {
      "inputs": [
        ".github/**",
        ".githooks/**",
        "**/*.md",
        "*.{js,json,jsonc,mjs,ts,yaml,yml}",
        "apps/**",
        "packages/**",
        "services/**",
        "tools/**",
        "workers/**"
      ]
    },
    "//#unused:check": {
      "inputs": [
        "apps/**",
        "knip.json",
        "package.json",
        "packages/**",
        "services/**",
        "tools/**",
        "tsconfig*.json",
        "workers/**"
      ]
    },
    "//#architecture:check": {
      "inputs": [
        "apps/**",
        "packages/**",
        "services/**",
        "tools/verify-architecture.ts",
        "workers/**"
      ]
    },
    "//#architecture:test": {
      "inputs": ["tools/verify-architecture.ts", "tools/verify-architecture.test.ts"]
    },
    "//#platform:check": {
      "inputs": [
        "README.md",
        "docs/operations/LOCAL_DEVELOPMENT.md",
        "infra/compose/**",
        "tools/reset-local-platform.sh",
        "tools/verify-local-platform.mjs"
      ]
    },
    "//#platform:test": {
      "inputs": [
        "README.md",
        "docs/operations/LOCAL_DEVELOPMENT.md",
        "infra/compose/**",
        "tools/reset-local-platform.sh",
        "tools/reset-local-platform.test.mjs",
        "tools/verify-local-platform.mjs",
        "tools/verify-local-platform.test.mjs"
      ]
    },
    "//#ai:check": {
      "inputs": [".ai/**", "tools/verify-ai-state.ts"]
    },
    "//#ai:test": {
      "inputs": [".ai/**", "tools/verify-ai-state.ts", "tools/verify-ai-state.test.ts"]
    },
    "//#docs:check": {
      "inputs": ["**/*"]
    },
    "//#docs:test": {
      "inputs": ["tools/verify-documentation.ts", "tools/verify-documentation.test.ts"]
    },
    "//#community:check": {
      "inputs": ["**/*"]
    },
    "//#community:test": {
      "inputs": [
        ".github/ISSUE_TEMPLATE/**",
        ".github/PULL_REQUEST_TEMPLATE.md",
        "CONTRIBUTING.md",
        "SECURITY.md",
        "tools/verify-community-files.ts",
        "tools/verify-community-files.test.ts"
      ]
    },
    "//#security:check": {
      "cache": false,
      "inputs": ["**/*"]
    },
    "//#security:test": {
      "inputs": ["tools/scan-secrets.ts", "tools/scan-secrets.test.ts"]
    },
    "//#ci:check": {
      "inputs": [
        ".github/**",
        "infra/compose/**",
        "tools/verify-ci-policy.ts",
        "tools/verify-local-platform.mjs"
      ]
    },
    "//#ci:test": {
      "inputs": [
        ".github/**",
        "tools/classify-ci-change.ts",
        "tools/classify-ci-change.test.ts",
        "tools/verify-ci-policy.ts",
        "tools/verify-ci-policy.test.ts",
        "tools/reset-local-platform.sh",
        "tools/reset-local-platform.test.mjs",
        "tools/verify-local-platform.mjs",
        "tools/verify-local-platform.test.mjs"
      ]
    },
    "//#commit:test": {
      "inputs": ["tools/validate-commit-message.ts", "tools/validate-commit-message.test.ts"]
    },
    "//#staged:test": {
      "inputs": ["tools/check-staged-files.ts", "tools/check-staged-files.test.ts"]
    }
  }
}
