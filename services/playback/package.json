{
  "name": "@aster/playback",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Playback-owned short-lived sessions and delivery policies.",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist/src",
    "migrations/*.sql"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build ./tsconfig.json",
    "test": "node --test ./dist/test/*.test.js",
    "typecheck": "tsc --project ./tsconfig.json --noEmit --composite false --incremental false"
  },
  "dependencies": {
    "@aster/postgres": "workspace:*"
  },
  "devDependencies": {
    "pg": "8.23.0",
    "@types/pg": "8.23.1",
    "@types/node": "24.13.3",
    "typescript": "6.0.3"
  }
}
