{
  "name": "@aster/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Product-empty Identity reference runtime composition.",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build ./tsconfig.json",
    "check": "node ./dist/src/check-identity.js",
    "start": "node ./dist/src/main.js",
    "test": "node --test ./dist/test/*.test.js",
    "typecheck": "tsc --project ./tsconfig.json --noEmit --composite false --incremental false"
  },
  "dependencies": {
    "@aster/config": "workspace:*",
    "@aster/http-express": "workspace:*",
    "@aster/postgres": "workspace:*",
    "@aster/redis": "workspace:*",
    "@aster/runtime": "workspace:*",
    "@aster/telemetry": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3"
  }
}
