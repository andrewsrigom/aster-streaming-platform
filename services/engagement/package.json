{
  "name": "@aster/engagement",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Engagement-owned durable progress, history and watchlist.",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist/src",
    "migrations/*.sql"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build ./tsconfig.json",
    "start": "node ./dist/src/main.js",
    "migrate:local": "node ./dist/src/migrate-local.js",
    "events:replay": "node ./dist/src/replay-identity-event.js",
    "test": "node --test ./dist/test/*.test.js",
    "typecheck": "tsc --project ./tsconfig.json --noEmit --composite false --incremental false"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@apollo/subgraph": "2.14.4",
    "@as-integrations/express5": "1.1.2",
    "@aster/broker-kafka": "workspace:*",
    "@aster/event-delivery": "workspace:*",
    "@aster/http-express": "workspace:*",
    "@aster/postgres": "workspace:*",
    "@aster/redis": "workspace:*",
    "@aster/runtime": "workspace:*",
    "@aster/telemetry": "workspace:*",
    "dataloader": "2.2.3",
    "graphql": "16.14.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
