{
  "name": "@aster/discovery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Discovery-owned versioned title search and home read models.",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist/src",
    "migrations/*.sql"
  ],
  "scripts": {
    "build": "tsc --build ./tsconfig.json",
    "test": "node --test ./dist/test/*.test.js",
    "typecheck": "tsc --project ./tsconfig.json --noEmit --composite false --incremental false"
  },
  "dependencies": {
    "@aster/event-delivery": "workspace:*",
    "@aster/postgres": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  }
}
