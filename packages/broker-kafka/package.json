{
  "name": "@aster/broker-kafka",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bounded Kafka-compatible transport lifecycle for Aster.",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build ./tsconfig.json",
    "check": "node ./dist/src/check-broker.js",
    "test": "node --test ./dist/test/*.test.js",
    "typecheck": "tsc --project ./tsconfig.json --noEmit --composite false --incremental false"
  },
  "dependencies": {
    "@aster/telemetry": "workspace:*",
    "kafkajs": "2.2.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3"
  }
}
