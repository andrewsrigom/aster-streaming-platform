{
  "name": "@aster/http-express",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bounded Express transport adapter for Aster Node.js services.",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist/src"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build ./tsconfig.json",
    "check": "node ./dist/src/check-http-express.js",
    "test": "node --test ./dist/test/*.test.js",
    "typecheck": "tsc --project ./tsconfig.json --noEmit --composite false --incremental false"
  },
  "dependencies": {
    "content-type": "3.0.0",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@types/content-type": "1.1.9",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "graphql": "16.14.2",
    "typescript": "6.0.3"
  }
}
