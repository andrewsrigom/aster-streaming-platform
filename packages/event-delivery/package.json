{
  "name": "@aster/event-delivery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bounded owner outbox delivery and versioned event transport contracts.",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist/src"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build ./tsconfig.json",
    "test": "node --test ./dist/test/*.test.js",
    "typecheck": "tsc --project ./tsconfig.json --noEmit --composite false --incremental false"
  },
  "dependencies": {
    "@aster/broker-kafka": "workspace:*",
    "@aster/postgres": "workspace:*",
    "@aster/runtime": "workspace:*",
    "@aster/telemetry": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "typescript": "7.0.2"
  }
}
